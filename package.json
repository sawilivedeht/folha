    "test": "vitest run",
    "cap:sync": "npm run build && npx cap sync android"
  },
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true
}
