{
  "name": "folha",
  "version": "0.1.0",
  "description": "Folha: leitor de e-books estilo Kindle",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "npm run build && npx cap sync android",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "convert-pdf": "node --experimental-strip-types scripts/convert-pdf.mjs"
  },
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^21.0.4",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true
}
